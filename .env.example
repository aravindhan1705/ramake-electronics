# REMAKE ELECTRONICS - Example Environment Configuration Template

PORT=3000
NODE_ENV=development
OTP_SECRET=your_custom_secret_key_here
ENABLE_DEV_MAILBOX=true

# Real SMTP Credentials (e.g. Gmail App Password, Brevo, SendGrid, Amazon SES)
# If left blank, the application uses local dev mailbox testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="REMAKE ELECTRONICS" <your_email@gmail.com>
